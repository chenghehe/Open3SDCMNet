<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <PackageId>Open3SDCMNet</PackageId>
    <Authors>Open3SDCMNet contributors</Authors>
    <Description>Managed reader for 3Shape HPS dental scan meshes with STL, PLY and textured OBJ export.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT AND BSL-1.0</PackageLicenseExpression>
    <PackageOutputPath>artifacts</PackageOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;benchmarks/**;artifacts/**;BenchmarkDotNet.Artifacts/**</DefaultItemExcludes>
    <PackageTags>3Shape;DCM;HPS;mesh;STL;PLY;OBJ</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <None Update="README.md;README.en.md;LICENSE;THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
